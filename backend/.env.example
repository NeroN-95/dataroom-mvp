# PostgreSQL (docker-compose maps container 5432 -> host 5433)
DATABASE_URL="postgresql://dataroom:dataroom@localhost:5433/dataroom?schema=public"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Google sign-in (optional). Get a Web OAuth Client ID from Google Cloud Console.
# Leave empty to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=""

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Blob storage: "local" (dev, writes to ./storage) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Upload limits
MAX_FILE_SIZE_MB=50

# --- S3 (only needed when STORAGE_DRIVER=s3) ---
# S3_ENDPOINT=""              # leave empty for AWS; set for Supabase/MinIO/R2
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_PREFIX="dataroom"
# S3_FORCE_PATH_STYLE="true"  # true for Supabase/MinIO, false for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
